# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abc.mongodb.net/collaborative-editor?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=your_very_secure_random_secret_key_here

# Allowed Frontend Origins (Comma-separated for production)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Email (Nodemailer) Configuration (if using verification)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
FRONTEND_URL=https://your-app.vercel.app
